<?xml version="1.0" encoding="utf-8"?>
<!--
  Recommended NuGet.config for com.github.asus4.onnxruntime + NuGetForUnity.

  Goal: install Microsoft.ML.OnnxRuntime (native) from nuget.org while
  routing Microsoft.ML.OnnxRuntime.Managed to a local stub feed bundled
  inside the UPM package. The managed C# code is provided by the UPM
  package itself, so the official Managed nupkg must not be expanded.

  This file is placed at the project root by Editor/NuGetConfigSetup.cs.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="onnx-managed-stub" value="Packages/com.github.asus4.onnxruntime/NuGetStubs~" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="onnx-managed-stub">
      <package pattern="Microsoft.ML.OnnxRuntime.Managed" />
    </packageSource>
  </packageSourceMapping>
</configuration>
